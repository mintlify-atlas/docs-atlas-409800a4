  "keyFeatures": [
    "Microservices architecture with .NET Aspire orchestration",
    "Multi-tenant transportation system with driver, passenger, and company support",
    "Real-time trip management and booking system",
    "Integrated wallet and payment processing with Moyasar",
    "OpenID Connect authentication with OTP-based login",
    "RabbitMQ-based event-driven messaging with Wolverine",
    "Multi-currency support with flexible commission policies",
    "Comprehensive admin dashboard with financial reports",
    "Review and rating system for drivers, passengers, and companies",
    "YARP reverse proxy gateway for unified API access",
    "PostgreSQL database with migration management",
    "OpenTelemetry observability with Grafana, Prometheus, Loki, and Jaeger"
  ],
  "publicApiSurface": [
    "POST /api/auth/send-otp - Send OTP for authentication",
    "POST /api/auth/resend-otp - Resend OTP",
    "POST /connect/token - Exchange OTP for access token",
    "GET /api/trips/search/unified - Unified trip search",
    "POST /api/public-trips/{tripId}/book - Book a public trip",
    "GET /api/drivers/{driverId}/trips - Get driver trips",
    "GET /api/passengers/{passengerId}/trips - Get passenger trips",
    "POST /api/drivers/{driverId}/trips - Create driver trip",
    "POST /api/companies/{companyId}/trips - Create company trip",
    "GET /api/drivers/{driverId}/wallet - Get driver wallet",
    "GET /api/passengers/{passengerId}/wallet - Get passenger wallet",
    "POST /api/wallet/top-up/bank-transfer - Top up wallet via bank transfer",
    "POST /api/bookings/{bookingId}/verify-payment - Verify payment",
    "POST /api/bookings/{bookingId}/cancel - Cancel booking",
    "POST /api/trips/{tripId}/driver-review - Submit driver review",
    "POST /api/trips/{tripId}/passenger-review - Submit passenger review",
    "GET /api/admin/dashboard/financial-summary - Admin financial dashboard",
    "GET /api/admin/trips - List all trips (admin)",
    "GET /api/admin/wallets/drivers - List driver wallets (admin)",
    "POST /api/admin/trips/{tripId}/cancel - Cancel trip (admin)",
    "GET /api/zones/validate-travel - Validate travel between zones",
    "GET /api/currencies - List supported currencies",
    "POST /api/notifications - Send notification",
    "POST /api/device-tokens - Register device token"
  ]
}
